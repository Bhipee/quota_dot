<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd template (macOS). Needed for the heatmap and overview pages: they read
     ~/.cc-switch on this Mac. Don't edit the placeholders by hand; run
       ./deploy/install-launchd.sh
     which fills them in and installs the result to ~/Library/LaunchAgents/.
     Placeholders: __REPO_DIR__ (this checkout), __PYTHON__ (python3 to use). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>tech.mindreset.quota-dot</string>
  <key>WorkingDirectory</key><string>__REPO_DIR__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string><string>quotadot</string><string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/quota-dot.log</string>
  <key>StandardErrorPath</key><string>/tmp/quota-dot.log</string>
</dict>
</plist>
