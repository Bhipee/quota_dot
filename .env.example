# ---- Dot. Open API (Dot. App → More → API Key; serial number in device info)
DOT_API_KEY=dot_app_xxxxxxxx
DOT_DEVICE_ID=ABCD1234ABCD
DOT_TASK_TYPE=loop            # loop (default) or fixed
DOT_REFRESH_NOW=true
DOT_BORDER=0

# ---- Pages: which screens to push. Leave unset to use every page whose data is available here.
#      `python -m quotadot list` shows them all.
PAGES=overview,heatmap     # also available: quota

# Each page needs its own Image API item in the device's list, or they overwrite each other.
# Get the keys with: curl -H "Authorization: Bearer $DOT_API_KEY" \
#   https://dot.mindreset.tech/api/authV2/open/device/$DOT_DEVICE_ID/loop/list
PAGE_OVERVIEW_TASK_KEY=
PAGE_HEATMAP_TASK_KEY=
#PAGE_QUOTA_TASK_KEY=
# Optional per page: PAGE_<NAME>_INTERVAL (seconds), PAGE_<NAME>_ALIAS (name shown in Dot. App),
# PAGE_<NAME>_TASK_TYPE (loop|fixed)
PAGE_OVERVIEW_INTERVAL=900
PAGE_OVERVIEW_WEEKS=10       # recent weeks in the overview grid, 4..13
PAGE_OVERVIEW_METRIC=tokens
#PAGE_QUOTA_INTERVAL=900
PAGE_HEATMAP_INTERVAL=3600
PAGE_HEATMAP_METRIC=tokens    # tokens | fresh (in+out, no cache) | cost
#PAGE_HEATMAP_WEEKS=24

# ---- Source: codex
CODEX_AUTH_PATH=~/.codex/auth.json

# ---- Source: relays (fill the groups you use, delete the rest)
NEXUS_NAME=Nexus
NEXUS_BASE=https://your-nexus-host/api/common
NEXUS_KEY=sk-xxxxxxxx

COMPANY_NAME=Company          # company API, LiteLLM team: GET {base}/team/info?team_id=...
COMPANY_BASE=https://your-litellm-host
COMPANY_KEY=sk-xxxxxxxx
COMPANY_TEAM_ID=your-team-id
COMPANY_USER_ID=your-user-id

# Or list every relay here instead (overrides NEXUS_* and COMPANY_*); keep the single quotes:
#RELAYS='[{"type":"nexus","name":"Nexus","base":"https://...","key":"sk-..."},{"type":"litellm","name":"Company","base":"https://...","key":"sk-...","team_id":"...","user_id":"..."}]'

# ---- Source: ccswitch (heatmap page; only where cc-switch runs)
#CCSWITCH_DB=~/.cc-switch/cc-switch.db

TZ_NAME=Asia/Shanghai
